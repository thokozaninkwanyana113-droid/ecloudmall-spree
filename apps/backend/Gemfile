# frozen_string_literal: true

source 'https://rubygems.org'
ruby file: '.ruby-version'

# EcloudMall: Spree engines come from this monorepo (spree/), so the app always runs the
# exact engine code it was tested with — locally, in CI and in the production Docker image.
spree_path = '../../spree' # relative to this Gemfile; keeps Gemfile.lock portable
gem 'spree', path: spree_path
gem 'spree_admin', path: "#{spree_path}/admin"
gem 'spree_emails', path: "#{spree_path}/emails"
gem 'spree_marketplace', path: "#{spree_path}/marketplace"

# Extensions



# Rails & Infrastructure
gem 'aws-sdk-s3', require: false
