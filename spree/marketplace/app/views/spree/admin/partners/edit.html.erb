<%= content_for :page_title do %>
  <%= page_header_back_button(collection_url) %>
  <%= @object.name %>
  <span class="badge <%= @object.live? ? 'badge-success' : 'badge-light' %>"><%= Spree.t("marketplace.partner_statuses.#{@object.status}") %></span>
<% end %>

<%= form_with model: @object, url: object_url, scope: :partner, id: "edit_partner_#{@object.id}" do |f| %>
  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-7">
      <%= render 'spree/admin/shared/error_messages', target: @object %>
      <%= render 'form', f: f %>
      <%= render 'spree/admin/shared/edit_resource_links', f: f %>
    </div>
    <div class="col-span-12 lg:col-span-5">
      <%= render 'spree/admin/partners/statement', partner: @object %>
    </div>
  </div>
<% end %>
